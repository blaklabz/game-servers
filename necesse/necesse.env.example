# Copy to /home/necesse/.config/necesse-ops.env, chmod 600, and DO NOT COMMIT IT.
NECESSE_HOME=/home/necesse
NECESSE_INSTALL=/home/necesse/server
NECESSE_STEAMCMD=/home/necesse/steamcmd/steamcmd.sh
NECESSE_WORLD=BlakLabzFoundry
NECESSE_PORT=14159
NECESSE_SLOTS=8
NECESSE_PAUSE_WHEN_EMPTY=1
NECESSE_SESSION=necesse
NECESSE_LOG=/home/necesse/necesse-console.log
NECESSE_STOP_TIMEOUT=90
DISCORD_WEBHOOK_URL=
# Tune these after capturing real Necesse logs:
# NECESSE_JOIN_REGEX=...
# NECESSE_LEAVE_REGEX=...
# NECESSE_READY_REGEX=...
